{
  "name": "onrepeat-music",
  "version": "1.0.0",
  "private": true,
  "description": "OnRepeat Music - Monorepo",
  "scripts": {
    "dev": "concurrently -n backend,web -c blue,green \"pnpm --filter @onrepeat/backend start:dev\" \"pnpm --filter @onrepeat/web dev\"",
    "dev:web": "pnpm --filter @onrepeat/web dev",
    "dev:backend": "pnpm --filter @onrepeat/backend start:dev",
    "build": "pnpm --filter @onrepeat/backend build && pnpm --filter @onrepeat/web build",
    "build:backend": "pnpm --filter @onrepeat/backend build",
    "build:web": "pnpm --filter @onrepeat/web build",
    "start": "concurrently -n backend,web -c blue,green \"pnpm --filter @onrepeat/backend start:prod\" \"pnpm --filter @onrepeat/web start\"",
    "start:web": "pnpm --filter @onrepeat/web start",
    "start:backend": "pnpm --filter @onrepeat/backend start:prod",
    "lint": "pnpm --filter @onrepeat/backend lint && pnpm --filter @onrepeat/web lint",
    "lint:backend": "pnpm --filter @onrepeat/backend lint",
    "lint:web": "pnpm --filter @onrepeat/web lint",
    "test": "pnpm --filter @onrepeat/backend test",
    "test:backend": "pnpm --filter @onrepeat/backend test",
    "format": "pnpm --filter @onrepeat/backend format",
    "db:migrate": "pnpm --filter @onrepeat/backend migrate",
    "db:migrate:dev": "pnpm --filter @onrepeat/backend migrate:dev",
    "db:seed": "pnpm --filter @onrepeat/backend seed",
    "db:setup": "pnpm --filter @onrepeat/backend db:setup",
    "prisma:generate": "pnpm --filter @onrepeat/backend prisma:generate",
    "types:generate": "pnpm --filter @onrepeat/types generate",
    "types:watch": "pnpm --filter @onrepeat/types generate:watch"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.0.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
