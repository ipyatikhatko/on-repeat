{
  "name": "@onrepeat/types",
  "version": "1.0.0",
  "private": true,
  "description": "Shared TypeScript types and OpenAPI generated types",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "generate:watch": "nodemon --watch ../../apps/backend/src --ext ts --delay 3 -e ts --exec 'pnpm generate'",
    "build": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "openapi-typescript": "^7.4.2",
    "wait-on": "^7.2.0",
    "tsx": "^4.7.0",
    "nodemon": "^3.0.0",
    "typescript": "^5.6.3"
  }
}
